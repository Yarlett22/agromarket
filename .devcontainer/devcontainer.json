{
  "name": "AgroMarket",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "forwardPorts": [
    8443,
    8080,
    8222
  ],
  "portsAttributes": {
    "8443": {
      "label": "AgroMarket (HTTPS)",
      "protocol": "https",
      "onAutoForward": "openBrowser"
    },
    "8080": {
      "label": "HTTP \u2192 redirige a HTTPS",
      "onAutoForward": "silent"
    },
    "8222": {
      "label": "NATS monitor",
      "onAutoForward": "silent"
    }
  },
  "postStartCommand": "docker compose up -d --build"
}
